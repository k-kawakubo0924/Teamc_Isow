# docker-compose (PostgreSQL) と backend の接続情報
# 実際に使う値は .env にコピーして設定する（.env はコミットしない）

DB_HOST=localhost
DB_PORT=5432
DB_NAME=teamc_isow
DB_USER=teamc
DB_PASSWORD=teamc_password

# backend
SERVER_PORT=8080
# フロントエンド(Vite dev server)のオリジン。CORS許可用。
FRONTEND_ORIGIN=http://localhost:5173

# 画像の保存先（local: サーバーのフォルダ。ローカル開発では以下は未設定のままでよい）
# IMAGE_STORAGE=local
# 保存先フォルダ（backend/ からの相対パス）
# IMAGE_LOCAL_DIR=./uploads
# ブラウザから画像を表示する URL の先頭部分（既定は http://localhost:<SERVER_PORT>/uploads）
# IMAGE_PUBLIC_BASE_URL=http://localhost:8080/uploads

# 1人が受けられる「進行中」の相談の上限（未設定なら 3）
# DM_MAX_RECEIVED_ACTIVE_CONVERSATIONS=3

# 管理者にするユーザーのメールアドレス（docs/admin.md「管理者アカウントの用意」）
# 先に新規会員登録でアカウントを作り、そのメールアドレスを書いてバックエンドを再起動すると、そのユーザーが管理者になる。
# 空なら何もしない。書き換えても、前に指定したユーザーは管理者のまま
ADMIN_EMAIL=

# JWT の署名用秘密鍵（32バイト以上のランダム値を Base64 で）
# 生成例: openssl rand -base64 48
JWT_SECRET=
